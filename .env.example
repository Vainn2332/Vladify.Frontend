# Copy this file to `.env` and fill in the values for your environment:
#
# Every VITE_-prefixed variable is inlined into the client bundle at build time
# and is therefore visible to anyone using the app. Never put a real secret
# (client secret, API key, connection string) in here.

# Auth0 tenant domain, from Application settings in the Auth0 dashboard.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Client ID of the Auth0 Single Page Application.
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Identifier of the API the access token is requested for. Must match the
# API identifier registered in Auth0 exactly — it is an identifier, not a URL
# that gets called.
VITE_AUTH0_AUDIENCE=https://Vladify/musicAPI
